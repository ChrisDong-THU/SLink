<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SLink" Width="520" Height="700" MinWidth="460" MinHeight="660" WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="CanResizeWithGrip" Background="#F5F5F7" FontFamily="Microsoft YaHei UI" FontSize="13"
 TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#1D1D1F"/><SolidColorBrush x:Key="Muted" Color="#6E6E73"/><SolidColorBrush x:Key="Blue" Color="#0066CC"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{StaticResource Blue}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Plate" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.76"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Opacity" Value="0.55"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.42"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#0066CC"/><Setter TargetName="Plate" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="CardIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="6"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Plate" CornerRadius="8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#EFF5FC"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Background" Value="#E2EDFA"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#0066CC"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DeviceCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Height" Value="80"/><Setter Property="Padding" Value="18,0"/>
   <Setter Property="Margin" Value="0,0,0,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Plate" CornerRadius="16" Background="White" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Plate" Property="Background" Value="#FAFCFF"/><Setter TargetName="Plate" Property="BorderBrush" Value="#D9E7F8"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plate" Property="Background" Value="#EFF5FC"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Plate" Property="BorderBrush" Value="#0066CC"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12"/><Setter Property="BorderBrush" Value="#D2D2D7"/><Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="14"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="Chrome"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,8,3">
   <Button x:Name="Minimize" Width="36" Padding="8" ToolTip="最小化" AutomationProperties.Name="最小化"/>
   <Button x:Name="HideButton" Width="36" Padding="8" ToolTip="隐藏到托盘" AutomationProperties.Name="隐藏到托盘"/>
  </StackPanel></Grid>
  <Grid Grid.Row="1" Margin="32,12,32,18">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock x:Name="StatusTitle" Text="正在检测" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="StatusDetail" Text="检查代理与网络状态" Foreground="{StaticResource Muted}" Margin="0,7,0,0" FontSize="12"/></StackPanel>
    <Button x:Name="Primary" Grid.Column="1" Background="{StaticResource Blue}" Foreground="White" VerticalAlignment="Center" Padding="17,13" Margin="12,0,0,0" AutomationProperties.Name="开启连接"/>
   </Grid>
   <UniformGrid Grid.Row="1" Columns="3" Margin="0,25,0,24">
    <StackPanel Margin="0,0,8,0"><TextBlock Text="代理" FontSize="11" Foreground="{StaticResource Muted}"/><ProgressBar x:Name="Progress0" Margin="0,8,0,0" Height="3" BorderThickness="0" Background="#E5E5EA" Foreground="{StaticResource Blue}" Maximum="100"/></StackPanel>
    <StackPanel Margin="4,0,4,0"><TextBlock Text="网卡" FontSize="11" Foreground="{StaticResource Muted}"/><ProgressBar x:Name="Progress1" Margin="0,8,0,0" Height="3" BorderThickness="0" Background="#E5E5EA" Foreground="{StaticResource Blue}" Maximum="100"/></StackPanel>
    <StackPanel Margin="8,0,0,0"><TextBlock Text="热点" FontSize="11" Foreground="{StaticResource Muted}"/><ProgressBar x:Name="Progress2" Margin="0,8,0,0" Height="3" BorderThickness="0" Background="#E5E5EA" Foreground="{StaticResource Blue}" Maximum="100"/></StackPanel>
   </UniformGrid>
   <Border x:Name="ErrorPanel" Grid.Row="2" Background="#FFF0EC" CornerRadius="10" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock x:Name="ErrorText" Foreground="#A84229" Margin="12" TextWrapping="Wrap" MaxHeight="48"/></Border>
   <Border x:Name="HotspotCard" Grid.Row="3" Background="White" CornerRadius="16" Padding="18" BorderBrush="Transparent" BorderThickness="1">
    <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="25"/><RowDefinition Height="32"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
      <Border Background="#EDF4FC" Width="44" Height="44" CornerRadius="12"><Viewbox x:Name="WifiGlyph" Width="24" Height="24"/></Border>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="HotspotName" Text="Wi-Fi 热点" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="Broadcast" Text="尚未开启" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
      <Button x:Name="EditHotspot" Grid.Column="4" Style="{StaticResource CardIconButton}" ToolTip="修改热点" AutomationProperties.Name="修改热点"/>
     </Grid>
     <Border Grid.Row="1" Background="#F0F0F3" Height="1" VerticalAlignment="Center"/>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="32"/><ColumnDefinition Width="4"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
      <Viewbox x:Name="PasswordGlyph" Width="18" Height="18" VerticalAlignment="Center"/>
      <TextBlock x:Name="Password" Grid.Column="2" Text="••••••••" FontFamily="Segoe UI" Foreground="{StaticResource Muted}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <Button x:Name="ShowPassword" Grid.Column="4" Style="{StaticResource CardIconButton}" ToolTip="显示密码" AutomationProperties.Name="显示密码"/>
      <Button x:Name="CopyPassword" Grid.Column="6" Style="{StaticResource CardIconButton}" ToolTip="复制密码" AutomationProperties.Name="复制密码"/>
     </Grid>
    </Grid>
   </Border>
   <Grid Grid.Row="4" Margin="0,10,0,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="设备" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><Border Background="#E9E9ED" CornerRadius="9" MinWidth="22" Height="20" Margin="8,0,0,0" Padding="6,0"><TextBlock x:Name="DeviceCount" Text="0" FontFamily="Segoe UI" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></StackPanel><Button x:Name="Refresh" HorizontalAlignment="Right" Style="{StaticResource CardIconButton}" ToolTip="刷新" AutomationProperties.Name="刷新设备"/></Grid>
   <Grid Grid.Row="5"><TextBlock x:Name="Empty" Text="等待设备连接" Foreground="#86868B" HorizontalAlignment="Center" VerticalAlignment="Center"/><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Devices"/></ScrollViewer></Grid>
   <Grid Grid.Row="6" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
    <Button x:Name="PortButton" HorizontalAlignment="Left" Padding="0,8" FontSize="11" Foreground="{StaticResource Muted}"/>
    <Button x:Name="Qobuz" Grid.Column="1" Padding="10,8" ToolTip="打开 Qobuz"/>
    <Button x:Name="Diagnostics" Grid.Column="2" Padding="8" ToolTip="诊断" AutomationProperties.Name="诊断"/>
   </Grid>
  </Grid>
  <Grid x:Name="Overlay" Grid.RowSpan="2" Background="#66000000" Visibility="Collapsed">
   <Border Background="White" CornerRadius="18" Padding="26" Margin="30" VerticalAlignment="Center">
    <StackPanel><TextBlock x:Name="DialogTitle" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18"/>
     <TextBox x:Name="DialogInput" MinHeight="44"/>
     <ComboBox x:Name="DialogSources" Visibility="Collapsed" MinHeight="40"/>
     <TextBox x:Name="DialogLogs" Visibility="Collapsed" IsReadOnly="True" TextWrapping="Wrap" Height="270" VerticalScrollBarVisibility="Auto" FontSize="12"/>
     <TextBlock x:Name="DialogError" TextWrapping="Wrap" Foreground="#A84229" Margin="0,10,0,0"/>
     <Grid Margin="0,20,0,0"><Button x:Name="DialogExtra" HorizontalAlignment="Left" Content="自动检测"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="DialogCancel" Content="取消" Margin="0,0,8,0"/><Button x:Name="DialogSave" Content="保存" Background="{StaticResource Blue}" Foreground="White" Padding="20,10"/></StackPanel></Grid>
    </StackPanel>
   </Border>
  </Grid>
 </Grid>
</Window>
